# ── Secrets — never commit these ─────────────────────────────
backend/.env
.env
*.env.local

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# ── Database — regenerated automatically on startup ──────────
*.db
*.db-journal

# ── Node / frontend build output ─────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/


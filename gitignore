backend/amenities_cache/*.geojson
backend/uploads/*
backend/outputs/*
backend/logs/*.log
!backend/uploads/.gitkeep
!backend/outputs/.gitkeep
!backend/logs/.gitkeep

# ── OS / editor cruft ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp


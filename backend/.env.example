# Database — used only for saved prediction run history (SQLite for local
# dev, Postgres in production). Login credentials are NOT stored here
# anymore — see users.json.
DATABASE_URL=sqlite:///./franchiseiq.db
# DATABASE_URL=postgresql+psycopg2://franchiseiq:franchiseiq_dev_password@localhost:5432/franchiseiq

# Auth — generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# v6.0 — path to the JSON file listing who's allowed to log in.
# Defaults to backend/users.json if not set.
# USERS_FILE=./users.json
